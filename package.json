{
  "name": "memory-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first media memory engine monorepo",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "contracts/codegen",
    "packages/*",
    "services/*",
    "workers/*"
  ],
  "scripts": {
    "lint": "node scripts/ci/run-workspace-check.mjs lint",
    "test": "node scripts/ci/run-workspace-check.mjs test",
    "codegen": "node scripts/ci/generate-contracts.mjs",
    "codegen:check": "node scripts/ci/check-codegen-freshness.mjs",
    "test:egress": "npm run build --workspace @memory-engine/api --silent && node scripts/ci/run-no-skip-tests.mjs tests/egress/*.test.mjs",
    "ci": "npm run lint && npm test && npm run codegen:check && npm run test:egress"
  }
}
