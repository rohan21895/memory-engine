{
  "name": "memory-engine",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "memory-engine",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "contracts/codegen",
        "packages/*",
        "services/*",
        "workers/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "contracts/codegen": {
      "name": "@memory-engine/contracts-codegen",
      "version": "0.0.0"
    },
    "node_modules/@memory-engine/contracts-codegen": {
      "resolved": "contracts/codegen",
      "link": true
    }
  }
}
