<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <!-- Android 14 requires the specific type as its own permission. dataSync is
       the honest category: this indexes local photos, it does not sync. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <!-- Android 13+ gates the notification itself. Without it the service still
       runs, it is just invisible, so this is requested but never required. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Required, not optional. HeadlessJsTaskService.startTask acquires a
       PARTIAL_WAKE_LOCK before it does anything else, so without this the
       service throws SecurityException the moment a scan starts. It also earns
       its keep: it is what lets the scan continue with the screen off, and the
       base class releases it in onDestroy. -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Lets the app show Android's own "allow background activity?" dialog
       instead of asking the user to hunt through OEM settings menus. Declaring
       it grants nothing: the user still answers the system prompt.

       Google Play restricts this permission to a short list of app categories,
       and a photo app is not on it. That is acceptable here and should be
       revisited before any Play listing: without it the app still works, it
       just has to send the user to the settings page by hand. -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <application>
    <service
      android:name=".ScanForegroundService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />
  </application>
</manifest>
