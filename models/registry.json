{
  "registry_version": "v0",
  "description": "Index of every model workers/ml-runtime may load, and the policy governing what may be loaded. Claude owns the contents; Codex owns the loader. A model not listed here cannot be loaded.",
  "load_policy": {
    "hash_mismatch_is_always_fatal": true,
    "modes": {
      "release": {
        "require_registered": true,
        "require_pinned_hash": true,
        "require_license_verified": true,
        "allow_blocks_commercial_release": false,
        "opt_in_env": null,
        "warn_per_load": false,
        "require_pinned_config": true
      },
      "development": {
        "require_registered": true,
        "require_pinned_hash": false,
        "require_license_verified": false,
        "allow_blocks_commercial_release": true,
        "opt_in_env": "MEMORY_ENGINE_ALLOW_UNVERIFIED_MODELS",
        "warn_per_load": true,
        "require_pinned_config": false
      }
    },
    "config_mismatch_is_always_fatal": true
  },
  "pipelines": {
    "photo_analysis": {
      "min_load_mode": "development",
      "steps": [
        "classical_quality",
        "siglip2-so400m-384",
        "scrfd-10g-bnkps",
        "arcface-buffalo-l"
      ],
      "note": "The selected stack. SCRFD + ArcFace are the most accurate available and are what the product is built on for internal use. Their weights are non-commercial, so this pipeline is development-only by construction -- release mode refuses it rather than someone remembering not to ship it. laion-aesthetic-v2 is removed until its head is retrained on SigLIP 2 features; a pipeline must be end-to-end runnable, and a known-broken step makes it a plan rather than a pipeline."
    },
    "photo_analysis_release": {
      "min_load_mode": "release",
      "steps": [
        "classical_quality",
        "siglip2-so400m-384",
        "yunet-2023mar"
      ],
      "note": "The licence-clean swap path. Detection only -- there is still no commercially-usable recognition model, which is the real open problem behind issue #3. Kept working so the swap is mechanical when it is needed. laion-aesthetic-v2 is removed until its head is retrained on SigLIP 2 features; a pipeline must be end-to-end runnable, and a known-broken step makes it a plan rather than a pipeline. NO SAFETY GATE YET: nsfw-siglip-head is registered but unselected, so this pipeline cannot filter sensitive content. That is a hard release blocker in its own right -- shipping automated albums and shared reels with no sensitive-content gate is a user-visible harm, not a quality gap -- and it is recorded here rather than in somebody's memory."
    },
    "video_analysis": {
      "min_load_mode": "development",
      "steps": [
        "transnetv2",
        "siglip2-so400m-384",
        "scrfd-10g-bnkps"
      ],
      "note": "Development-only for the same reason."
    }
  },
