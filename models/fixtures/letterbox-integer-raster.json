{
  "fixture_version": "v0",
  "description": "Letterbox onto a REAL raster, where every dimension is a whole pixel. The existing letterbox fixture uses 1920x1080 -> 640x640, where the arithmetic lands exactly and so specifies neither the rounding convention nor the odd-padding split. Codex flagged that and supplied the actual proxy dimensions ingest emits.",
  "proxy_geometry": {
    "source": "workers/ingest/src/video.rs",
    "rule": "Fixed 480 height; width preserves aspect and is rounded to a multiple of two. VideoToolbox uses 2*ceil((w*480/h)/2); NVDEC/QSV uses FFmpeg -2, which can land one step lower."
  },
  "conventions": {
    "resize": "round to nearest, NOT floor -- flooring shrinks by up to a pixel and biases every mapped coordinate one way instead of cancelling out",
    "pad_split": "pad_before = (target - scaled) // 2, so an odd pad puts the extra pixel at the BOTTOM/RIGHT",
    "inverse_map": "use effective_scale = scaled / source, NOT the ideal scale -- once the dimension is rounded, the image really is at the rounded scale, and un-letterboxing with the ideal one reintroduces the rounding as a coordinate offset",
    "axes": "width and height round independently, so effective_scale_x and effective_scale_y can differ; using one for both puts boxes slightly wrong on exactly the proxies where it is hardest to notice"
  },
